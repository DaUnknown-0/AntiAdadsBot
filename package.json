{
  "name": "discord-moderation-bot",
  "version": "1.0.0",
  "description": "Multi-server Discord moderation bot running on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:migrate": "wrangler d1 migrations apply discord-moderation-db",
    "db:local": "wrangler d1 migrations apply discord-moderation-db --local"
  },
  "keywords": [
    "discord",
    "moderation",
    "cloudflare-workers"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.3",
    "wrangler": "^4.58.0"
  },
  "dependencies": {
    "discord-interactions": "^4.1.0"
  }
}
